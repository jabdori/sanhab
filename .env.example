# cp .env.example .env 후 값 변경 (.env는 제출 zip에서 제외)
SURREAL_USER=root
SURREAL_PASS=change-me
# 시연 계정(support=영업지원팀, exec=영업임원, acct=회계, audit=내부감사) 공통 비밀번호
DEMO_PASS=change-me
# 운영 중 AI(조사 보고)와 서류 글자 인식. 값은 넣지 않고 이름만 둔다
OPENAI_API_KEY=
UPSTAGE_API_KEY=
# 기본 gpt-6.1-terra. 품질이 부족하면 gpt-6.1-sol
OPENAI_MODEL=gpt-6.1-terra
